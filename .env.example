# Bu dosyayı `.env` olarak kopyalayın. `.env` git'e KOMMİT EDİLMEZ.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# --- Veritabanı: iki ayrı rol ---
# Uygulama rolü NOBYPASSRLS'tir; RLS politikaları onun için zorunludur.
DATABASE_URL=postgres://klinara_app:klinara_dev_password@localhost:5433/klinara
# Migration rolü tabloların sahibidir ve RLS'i bypass eder.
DATABASE_MIGRATION_URL=postgres://klinara_owner:klinara_dev_password@localhost:5433/klinara
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=10000

# --- Uygulama ---
# ⚠️ Randevu web sitesi (apps/web-booking) bu listede YOKTUR ve olmamalıdır:
# tarayıcı API'ye doğrudan değil, Next'in kendi route handler proxy'si üzerinden
# (aynı origin) gider. Sebep: her kiracının özel alan adı ayrı bir Origin'dir ve
# statik bir liste onları hiçbir zaman sayamaz.
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT_BYTES=1048576
SHUTDOWN_GRACE_MS=10000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# --- Gözlemlenebilirlik ---
SERVICE_NAME=klinara-api
SERVICE_VERSION=0.0.0
# Tanımlıysa OpenTelemetry açılır.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Tanımlıysa Sentry açılır.
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# /metrics ucunu koruyan bearer token. Üretimde ZORUNLU (>= 16 karakter).
METRICS_TOKEN=yerel-metrik-tokeni

# --- Platform yönetimi ---
# /platform/* uçları için bearer token (üretimde >= 32 karakter).
PLATFORM_ADMIN_TOKEN=yerel-platform-admin-tokeni

# --- Kimlik (Faz 1) ---
# En az 32 karakter. Değiştirmek tüm access token'ları geçersiz kılar.
JWT_SECRET=yerel-gelistirme-jwt-anahtari-en-az-32-karakter
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_CHALLENGE_TTL=5m
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=30
# Davet / sıfırlama bağlantılarının gösterileceği web adresi.
# ⚠️ Bu, PERSONEL panelinin adresidir (davet ve parola sıfırlama bağlantıları
# buraya çıkar) — public randevu sayfasının değil. web-booking'e çevirmeyin.
APP_BASE_URL=http://localhost:5173

# 32 baytlık base64 anahtar: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=Zm9vYmFyZm9vYmFyZm9vYmFyZm9vYmFyZm9vYmFyMDA=
FIELD_ENCRYPTION_KEY_ID=v1

# --- Passkey (WebAuthn) ---
# rpId ETKİN ALAN ADIDIR ve sonradan değiştirilemez: değişirse tüm passkey'ler yanar.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Klinara
# ⚠️ Yalnız personel panelinin origin'i. Public randevu sayfası hiçbir zaman
# bir WebAuthn origin'i OLMAMALIDIR: orada kimlik doğrulaması yapılmıyor ve
# passkey rpId'sini oraya genişletmek oltalama yüzeyi açardı.
WEBAUTHN_ORIGINS=http://localhost:5173
WEBAUTHN_CHALLENGE_TTL_MINUTES=5

# --- SMS / telefon doğrulama (Netgsm) ---
# Boşsa SMS GÖNDERİLMEZ, içerik yalnız loga yazılır.
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
NETGSM_BASE_URL=https://api.netgsm.com.tr
PHONE_VERIFICATION_TTL_MINUTES=5
PHONE_VERIFICATION_MAX_ATTEMPTS=5
PHONE_VERIFICATION_RESEND_SECONDS=60

# Depolama (S3 / MinIO) — Batch 4.3
# Kimlik bilgileri boşsa gerçek S3 istemcisi kurulmaz; bellek-içi depolama devreye girer.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=klinara
S3_ACCESS_KEY_ID=klinara
S3_SECRET_ACCESS_KEY=klinara_dev_password
S3_PRESIGN_TTL_SECONDS=300
UPLOAD_MAX_BYTES=26214400

# Kuyruk (pg-boss) — Batch 4.3
QUEUE_ENABLED=true
QUEUE_SCHEMA=pgboss

# --- E-posta gönderimi (SMTP) — Batch 8.1 ---
# Boşsa e-posta GÖNDERİLMEZ, içerik yalnız loga yazılır.
# Yerelde MailHog: docker compose ile gelir, arayüzü http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=Klinara <bildirim@klinara.local>

# --- Bildirim çekirdeği — Batch 8.1 ---
# Kiracı/şube tercihi yoksa geçerli sessiz saat penceresi (şube saat diliminde).
# Gece yarısını aşan pencere geçerlidir.
NOTIFICATION_QUIET_HOURS_START=21:00
NOTIFICATION_QUIET_HOURS_END=09:00

# --- WhatsApp Cloud API — Batch 8.2 ---
# Kiracı kimlik bilgileri (token, app secret) VERİTABANINDA şifreli durur;
# buradakiler platform seviyesidir.
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TIMEOUT_MS=10000
# Meta webhook kaydında sorulan doğrulama sırrı (en az 16 karakter) — Batch 8.3
WHATSAPP_WEBHOOK_VERIFY_TOKEN=yerel-webhook-dogrulama-tokeni
# Onayla/İptal buton token'ının ömrü (saat)
MESSAGE_ACTION_TTL_HOURS=48

# --- Online randevu sayfası — Faz 9 ---
# Platform subdomain'lerinin kök alan adı: {slug}.{PUBLIC_BOOKING_DOMAIN}.
# Yerelde `klinara.localhost`: *.localhost hosts dosyasına dokunmadan
# 127.0.0.1'e çözülür, yani geliştirme için wildcard DNS gerekmez.
PUBLIC_BOOKING_DOMAIN=klinara.localhost
# Özel alan adlarının göstereceği CNAME hedefi. Boşsa kiracının kendi platform
# subdomain'i kullanılır.
BOOKING_DNS_TARGET=
# Kenar proxy'sinin (Caddy on-demand TLS) iç uçlarda kullandığı token.
# PLATFORM_ADMIN_TOKEN ile AYNI OLAMAZ — env doğrulaması reddeder: kenar proxy
# tek bir evet/hayır sorusunu cevaplayabilmeli, kiracı verisine erişememeli.
EDGE_AUTH_TOKEN=yerel-kenar-proxy-tokeni-32-karakterden-uzun
# Kaç ardışık başarısız DNS kontrolünden sonra alan adı `failed` olur
BOOKING_DOMAIN_MAX_CHECK_ATTEMPTS=10

# Public görseller: imzasız, değişmez anahtar, CDN önünde (max-age=1yıl)
PUBLIC_ASSET_BASE_URL=http://localhost:9000/klinara
S3_PUBLIC_PREFIX=public
BOOKING_ASSET_MAX_BYTES=5242880

# Slot tutma ve OTP — Batch 9.4
SLOT_HOLD_TTL_MINUTES=10
# Bir IP/telefon aynı anda kaç aktif tutma yapabilir (slot işgali sınırı)
BOOKING_HOLD_MAX_ACTIVE=2
# Opak slot token'ının ömrü (dakika)
SLOT_TOKEN_TTL_MINUTES=30
BOOKING_OTP_TTL_MINUTES=5
BOOKING_OTP_MAX_ATTEMPTS=5
BOOKING_OTP_RESEND_SECONDS=60
# ⚠️ Kimlik doğrulamasız OTP ucu DOĞRUDAN FATURAYA yazan bir saldırı yüzeyidir.
BOOKING_OTP_MAX_PER_PHONE_PER_DAY=10
BOOKING_OTP_MAX_PER_SITE_PER_DAY=500

# Public uçların kendi hız sınırı (IP + slug bazlı), iç API'den bağımsız
PUBLIC_RATE_LIMIT_MAX=60
PUBLIC_RATE_LIMIT_WINDOW_MS=60000

# Self-servis bağlantısının ömrü (saat) — Batch 9.5
BOOKING_ACCESS_TOKEN_TTL_HOURS=720


# --- Randevu web sitesi (Faz 11 — apps/web-booking) ---
# Next.js uygulamasının portu. 3000 API'nin.
WEB_PORT=3001
# Next route handler proxy'sinin yukarı akış adresi. Tarayıcıya ASLA sızmaz.
API_INTERNAL_URL=http://localhost:3000/api/v1
# Tarayıcıya inlenen değerler (NEXT_PUBLIC_*). Sır koymayın.
NEXT_PUBLIC_BOOKING_DOMAIN=klinara.localhost
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:9000/klinara
# Yerelde konak adı çözümlemesini atlamak için (yalnız NODE_ENV != production).
NEXT_PUBLIC_DEV_SLUG=demo-klinik

# Yayında purge-on-publish: API yayın sonrası bu ucu çağırıp Next'in
# tag cache'ini düşürür. Boşsa purge yapılmaz ve `s-maxage=300` yedekte kalır.
WEB_REVALIDATE_URL=http://localhost:3001/api/revalidate
WEB_REVALIDATE_SECRET=yerel-revalidate-sirri-32-karakterden-uzun-olmali
WEB_REVALIDATE_TIMEOUT_MS=5000
