{
  "name": "klinara",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter @klinara/api dev",
    "build": "pnpm --filter @klinara/shared build && pnpm --filter @klinara/api build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @klinara/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @klinara/shared build && pnpm --filter @klinara/api test",
    "db:generate": "pnpm --filter @klinara/api db:generate",
    "db:migrate": "pnpm --filter @klinara/api db:migrate",
    "db:seed": "pnpm --filter @klinara/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
