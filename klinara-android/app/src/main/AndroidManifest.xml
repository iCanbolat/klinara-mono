<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Personel push bildirimleri (Android 13+ çalışma zamanında sorulur). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Klinik fotoğrafı çoğu kez O AN çekiliyor (A4.4). Galeri için izin YOK ve
      olmayacak: Photo Picker (`PickVisualMedia`) kullanıcının seçtiği dosyayı
      veriyor, uygulama galeriye hiç erişmiyor.

      `required="false"`: kamerası olmayan bir cihazda uygulama yine kurulabilmeli —
      fotoğraf çekmek bir yol, tek yol değil.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".KlinaraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.Klinara.Starting">

        <!--
          FCM. Uygulama arka plandayken bildirimi sistem çizer; ikon ve kanal buradan.
          Kanal kimliği sunucudaki ANDROID_CHANNEL_ID ile aynı.
        -->
        <service
            android:name=".services.push.KlinaraMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_klinara_bell" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="staff_notifications" />

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Klinara.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
