<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  GENERATE_INFOPLIST_FILE açık kalır; Xcode ürettiği anahtarları
	  (scene manifest, launch screen, yönlendirme) bu dosyaya merge eder.
	  Buraya yalnız üretilemeyen anahtarlar yazılır.
	-->
	<key>UIAppFonts</key>
	<array>
		<!-- Değişken font: Regular/Medium/SemiBold örneklerini tek dosyada taşır. -->
		<string>Manrope-Variable.ttf</string>
		<string>SourceSerif4-Regular.ttf</string>
		<string>SourceSerif4-Semibold.ttf</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Kliniğinize parolanızı yazmadan, tek dokunuşla giriş yapmak için kullanılır.</string>

	<!--
	  Kamera YALNIZ müşteri kartına klinik fotoğrafı eklemek için kullanılır.
	  Öncesi/sonrası fotoğrafı çoğunlukla o anda çekiliyor ve galeriye
	  kaydedilmeden doğrudan karta giriyor; bu yüzden PhotosPicker tek başına
	  yetmiyor.
	-->
	<key>NSCameraUsageDescription</key>
	<string>Müşteri kartına öncesi/sonrası fotoğrafı eklemek için kamera kullanılır. Fotoğraflar yalnız kliniğinizin kaydına gider.</string>

	<!--
	  API kökü. Şema düzenlemeden değiştirilebilsin diye burada durur:
	  simülatör "localhost"a ulaşır, fiziksel cihaz Mac'in LAN adresine
	  (örn. http://192.168.1.20:3000/api/v1) bakmalıdır.
	-->
	<key>KlinaraAPIBaseURL</key>
	<string>http://localhost:3000/api/v1</string>

	<!--
	  ATS istisnası YALNIZ localhost için. Üretim kökü https'tir ve bu
	  istisna onu etkilemez; genel `NSAllowsArbitraryLoads` bilinçli olarak
	  kullanılmadı - tek bir yanlış yapılandırma tüm trafiği düz metne düşürürdü.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
